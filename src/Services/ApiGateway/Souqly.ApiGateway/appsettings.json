{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8180/realms/souqly",
    "Audience": "souqly-api",
    "PublicClientId": "souqly-web"
  },
  "RateLimiting": {
    "PermitsPerSecond": 20,
    "Burst": 40
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-public": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/{segment:regex(^(products|categories)$)}/{**rest}",
          "Methods": [
            "GET"
          ]
        }
      },
      "catalog-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/{segment:regex(^(products|categories)$)}/{**rest}",
          "Methods": [
            "POST",
            "PUT",
            "DELETE"
          ]
        }
      },
      "catalog-vendor": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/vendor/products/{**rest}"
        }
      },
      "inventory-public": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/stock-items/{productId:long}",
          "Methods": [
            "GET"
          ]
        }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/stock-items/{**rest}"
        }
      },
      "cart": {
        "ClusterId": "cart",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/carts/{**rest}"
        }
      },
      "ordering": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/orders/{**rest}"
        }
      },
      "ordering-vendor": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/vendor/orders/{**rest}"
        }
      },
      "openapi-catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/catalog.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "openapi-inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/inventory.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "openapi-cart": {
        "ClusterId": "cart",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/cart.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "openapi-ordering": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/ordering.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "inventory": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "cart": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "ordering": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      }
    }
  }
}
