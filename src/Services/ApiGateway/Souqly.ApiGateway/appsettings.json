{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitsPerSecond": 20,
    "Burst": 40
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/{segment:regex(^(products|categories)$)}/{**rest}" }
      },
      "catalog-vendor": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/vendor/products/{**rest}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/stock-items/{**rest}" }
      },
      "cart": {
        "ClusterId": "cart",
        "Match": { "Path": "/api/v1/carts/{**rest}" }
      },
      "openapi-catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/openapi/catalog.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/openapi/inventory.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-cart": {
        "ClusterId": "cart",
        "Match": { "Path": "/openapi/cart.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "d1": { "Address": "http://localhost:5101" } },
        "HttpRequest": { "ActivityTimeout": "00:00:10" }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://localhost:5102" } },
        "HttpRequest": { "ActivityTimeout": "00:00:10" }
      },
      "cart": {
        "Destinations": { "d1": { "Address": "http://localhost:5103" } },
        "HttpRequest": { "ActivityTimeout": "00:00:10" }
      }
    }
  }
}
