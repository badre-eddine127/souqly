{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "DevHeaders"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Inventory": {
    "ExpiryWorkerEnabled": true
  },
  "ConnectionStrings": {
    "InventoryDb": "Host=localhost;Port=5432;Database=inventory_db;Username=inventory;Password=inventory"
  }
}
