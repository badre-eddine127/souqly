{
    "openapi": "3.1.1",
    "info": {
        "title": "Souqly Inventory API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/vendor/stock-alerts": {
            "get": {
                "tags": [
                    "Espace vendeur"
                ],
                "summary": "Ruptures et stocks bas de mes produits (US-17)",
                "parameters": [
                    {
                        "name": "threshold",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/StockItemResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/stock-items/{productId}": {
            "get": {
                "tags": [
                    "Stock"
                ],
                "summary": "Disponibilit\u00e9 publique d'un produit (disponible = physique \u2212 r\u00e9serv\u00e9)",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AvailabilityResponse"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Stock"
                ],
                "summary": "Fixer le stock physique (vendeur propri\u00e9taire)",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SetStockRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StockItemResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/stock-items/{productId}/details": {
            "get": {
                "tags": [
                    "Stock"
                ],
                "summary": "D\u00e9tail du stock (vendeur propri\u00e9taire)",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StockItemResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/stock-items/{productId}/adjustments": {
            "post": {
                "tags": [
                    "Stock"
                ],
                "summary": "Ajuster le stock (+/\u2212, avec motif)",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AdjustStockRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StockItemResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/internal/v1/reservations": {
            "post": {
                "tags": [
                    "Interne"
                ],
                "summary": "R\u00e9server le stock d'une commande pour 15 minutes (tout ou rien, idempotent)",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ReserveStockRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReservationResult"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReservationResult"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/internal/v1/reservations/{orderId}/release": {
            "post": {
                "tags": [
                    "Interne"
                ],
                "summary": "Lib\u00e9rer les r\u00e9servations d'une commande (compensation)",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/internal/v1/reservations/{orderId}/commit": {
            "post": {
                "tags": [
                    "Interne"
                ],
                "summary": "Consommer les r\u00e9servations d'une commande confirm\u00e9e",
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AdjustStockRequest": {
                "required": [
                    "delta",
                    "reason"
                ],
                "type": "object",
                "properties": {
                    "delta": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            },
            "AvailabilityResponse": {
                "required": [
                    "productId",
                    "available",
                    "inStock"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "available": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "inStock": {
                        "type": "boolean"
                    }
                }
            },
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "ReservationResult": {
                "required": [
                    "orderId",
                    "status",
                    "failedProductId"
                ],
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "status": {
                        "type": "string"
                    },
                    "failedProductId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    }
                }
            },
            "ReserveLine": {
                "required": [
                    "productId",
                    "quantity"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "quantity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "ReserveStockRequest": {
                "required": [
                    "orderId",
                    "lines"
                ],
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ReserveLine"
                        }
                    }
                }
            },
            "SetStockRequest": {
                "required": [
                    "onHand"
                ],
                "type": "object",
                "properties": {
                    "onHand": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "lowStockThreshold": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "StockItemResponse": {
                "required": [
                    "productId",
                    "vendorId",
                    "onHand",
                    "reserved",
                    "available",
                    "lowStockThreshold",
                    "updatedAt"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "vendorId": {
                        "type": "string"
                    },
                    "onHand": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "reserved": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "available": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "lowStockThreshold": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        },
        "securitySchemes": {
            "oauth2": {
                "type": "oauth2",
                "description": "Connexion Keycloak (realm souqly), client public souqly-web avec PKCE.",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/auth",
                        "tokenUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/token",
                        "scopes": {
                            "openid": "Identit\u00e9 OpenID Connect"
                        }
                    }
                }
            },
            "bearer": {
                "type": "http",
                "description": "Jeton d'acc\u00e8s Keycloak coll\u00e9 \u00e0 la main (Authorization: Bearer \u2026).",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "oauth2": [
                "openid"
            ]
        },
        {
            "bearer": []
        }
    ],
    "tags": [
        {
            "name": "Espace vendeur"
        },
        {
            "name": "Stock"
        },
        {
            "name": "Interne"
        }
    ]
}
