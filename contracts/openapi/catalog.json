{
    "openapi": "3.1.1",
    "info": {
        "title": "Souqly Catalog API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/vendor/products": {
            "get": {
                "tags": [
                    "Espace vendeur"
                ],
                "summary": "Mes produits, y compris brouillons et archiv\u00e9s",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseOfProductResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/categories": {
            "get": {
                "tags": [
                    "Cat\u00e9gories"
                ],
                "summary": "Arbre des cat\u00e9gories",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/internal/v1/products/prices": {
            "get": {
                "tags": [
                    "Interne"
                ],
                "summary": "Instantan\u00e9 de prix pour la commande (RG-02)",
                "parameters": [
                    {
                        "name": "ids",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PriceSnapshot"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products": {
            "get": {
                "tags": [
                    "Produits"
                ],
                "summary": "Lister le catalogue public (pagin\u00e9, filtrable, triable)",
                "parameters": [
                    {
                        "name": "Category",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int64"
                        }
                    },
                    {
                        "name": "MinPrice",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                            "type": [
                                "number",
                                "string"
                            ],
                            "format": "double"
                        }
                    },
                    {
                        "name": "MaxPrice",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                            "type": [
                                "number",
                                "string"
                            ],
                            "format": "double"
                        }
                    },
                    {
                        "name": "Q",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Sort",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Page",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "Size",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseOfProductResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Produits"
                ],
                "summary": "Cr\u00e9er un produit (vendeur)",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products/{id}": {
            "get": {
                "tags": [
                    "Produits"
                ],
                "summary": "Fiche produit",
                "operationId": "GetProduct",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductResponse"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Produits"
                ],
                "summary": "Modifier un de ses produits (vendeur propri\u00e9taire)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Produits"
                ],
                "summary": "Archiver un de ses produits (vendeur propri\u00e9taire)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/api/v1/vendors": {
            "post": {
                "tags": [
                    "Vendeurs"
                ],
                "summary": "Demander l'ouverture d'une boutique (utilisateur connect\u00e9)",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VendorApplicationRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VendorApplicationResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VendorApplicationResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "tags": [
                    "Vendeurs"
                ],
                "summary": "Demandes \u00e0 traiter (administrateur)",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseOfVendorApplicationResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/vendors/me": {
            "get": {
                "tags": [
                    "Vendeurs"
                ],
                "summary": "Ma demande d'ouverture de boutique",
                "operationId": "GetMyVendorApplication",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VendorApplicationResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/vendors/{id}/approval": {
            "post": {
                "tags": [
                    "Vendeurs"
                ],
                "summary": "Valider ou refuser une boutique (administrateur)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VendorDecisionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VendorApplicationResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/vendors/shops": {
            "get": {
                "tags": [
                    "Vendeurs"
                ],
                "summary": "Boutiques valid\u00e9es (nom et ville)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/VendorShopResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CategoryResponse": {
                "required": [
                    "id",
                    "slug",
                    "name",
                    "parentId"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "parentId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    }
                }
            },
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "MoneyDto": {
                "required": [
                    "amount",
                    "currency"
                ],
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    }
                }
            },
            "PageResponseOfProductResponse": {
                "required": [
                    "content",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages"
                ],
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductResponse"
                        }
                    },
                    "page": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "size": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "totalElements": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "totalPages": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                },
                "description": "R\u00e9ponse pagin\u00e9e normalis\u00e9e : { content, page, size, totalElements, totalPages }."
            },
            "PageResponseOfVendorApplicationResponse": {
                "required": [
                    "content",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages"
                ],
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/VendorApplicationResponse"
                        }
                    },
                    "page": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "size": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "totalElements": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "totalPages": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                },
                "description": "R\u00e9ponse pagin\u00e9e normalis\u00e9e : { content, page, size, totalElements, totalPages }."
            },
            "PriceSnapshot": {
                "required": [
                    "productId",
                    "vendorId",
                    "name",
                    "price",
                    "purchasable"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "vendorId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "price": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "purchasable": {
                        "type": "boolean"
                    }
                }
            },
            "ProductRequest": {
                "required": [
                    "categoryId",
                    "sku",
                    "name",
                    "description",
                    "price"
                ],
                "type": "object",
                "properties": {
                    "categoryId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "sku": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "price": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "publish": {
                        "type": "boolean",
                        "default": false
                    }
                }
            },
            "ProductResponse": {
                "required": [
                    "id",
                    "vendorId",
                    "categoryId",
                    "sku",
                    "name",
                    "description",
                    "price",
                    "status",
                    "createdAt",
                    "updatedAt"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "vendorId": {
                        "type": "string"
                    },
                    "categoryId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "sku": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "price": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "status": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "VendorApplicationRequest": {
                "required": [
                    "shopName",
                    "city",
                    "description"
                ],
                "type": "object",
                "properties": {
                    "shopName": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "description": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "VendorApplicationResponse": {
                "required": [
                    "id",
                    "userId",
                    "shopName",
                    "city",
                    "description",
                    "status",
                    "rejectionReason",
                    "submittedAt",
                    "decidedAt"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "shopName": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "rejectionReason": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "submittedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "decidedAt": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "format": "date-time"
                    }
                }
            },
            "VendorDecisionRequest": {
                "required": [
                    "approved",
                    "reason"
                ],
                "type": "object",
                "properties": {
                    "approved": {
                        "type": "boolean"
                    },
                    "reason": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "VendorShopResponse": {
                "required": [
                    "vendorId",
                    "shopName",
                    "city"
                ],
                "type": "object",
                "properties": {
                    "vendorId": {
                        "type": "string"
                    },
                    "shopName": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "oauth2": {
                "type": "oauth2",
                "description": "Connexion Keycloak (realm souqly), client public souqly-web avec PKCE.",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/auth",
                        "tokenUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/token",
                        "scopes": {
                            "openid": "Identit\u00e9 OpenID Connect"
                        }
                    }
                }
            },
            "bearer": {
                "type": "http",
                "description": "Jeton d'acc\u00e8s Keycloak coll\u00e9 \u00e0 la main (Authorization: Bearer \u2026).",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "oauth2": [
                "openid"
            ]
        },
        {
            "bearer": []
        }
    ],
    "tags": [
        {
            "name": "Espace vendeur"
        },
        {
            "name": "Cat\u00e9gories"
        },
        {
            "name": "Interne"
        },
        {
            "name": "Produits"
        },
        {
            "name": "Vendeurs"
        }
    ]
}
