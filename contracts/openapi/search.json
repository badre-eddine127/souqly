{
    "openapi": "3.1.1",
    "info": {
        "title": "Souqly Search API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/search": {
            "get": {
                "tags": [
                    "Recherche"
                ],
                "summary": "Recherche en texte libre, tol\u00e9rante aux fautes, avec filtres cat\u00e9gorie et prix et facettes (US-04)",
                "parameters": [
                    {
                        "name": "Q",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Category",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int64"
                        }
                    },
                    {
                        "name": "MinPrice",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                            "type": [
                                "number",
                                "string"
                            ],
                            "format": "double"
                        }
                    },
                    {
                        "name": "MaxPrice",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                            "type": [
                                "number",
                                "string"
                            ],
                            "format": "double"
                        }
                    },
                    {
                        "name": "Page",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "Size",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SearchResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CategoryFacet": {
                "required": [
                    "categoryId",
                    "count"
                ],
                "type": "object",
                "properties": {
                    "categoryId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "count": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "MoneyView": {
                "required": [
                    "amount",
                    "currency"
                ],
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    }
                }
            },
            "PriceFacet": {
                "required": [
                    "min",
                    "max"
                ],
                "type": "object",
                "properties": {
                    "min": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "max": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "SearchFacets": {
                "required": [
                    "categories",
                    "price"
                ],
                "type": "object",
                "properties": {
                    "categories": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryFacet"
                        }
                    },
                    "price": {
                        "$ref": "#/components/schemas/PriceFacet"
                    }
                }
            },
            "SearchHitResponse": {
                "required": [
                    "productId",
                    "vendorId",
                    "categoryId",
                    "sku",
                    "name",
                    "description",
                    "price",
                    "score"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "vendorId": {
                        "type": "string"
                    },
                    "categoryId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "sku": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "price": {
                        "$ref": "#/components/schemas/MoneyView"
                    },
                    "score": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    }
                }
            },
            "SearchResponse": {
                "required": [
                    "query",
                    "content",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages",
                    "facets"
                ],
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SearchHitResponse"
                        }
                    },
                    "page": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "size": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "totalElements": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "totalPages": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "facets": {
                        "$ref": "#/components/schemas/SearchFacets"
                    }
                }
            }
        },
        "securitySchemes": {
            "oauth2": {
                "type": "oauth2",
                "description": "Connexion Keycloak (realm souqly), client public souqly-web avec PKCE.",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/auth",
                        "tokenUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/token",
                        "scopes": {
                            "openid": "Identit\u00e9 OpenID Connect"
                        }
                    }
                }
            },
            "bearer": {
                "type": "http",
                "description": "Jeton d'acc\u00e8s Keycloak coll\u00e9 \u00e0 la main (Authorization: Bearer \u2026).",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "oauth2": [
                "openid"
            ]
        },
        {
            "bearer": []
        }
    ],
    "tags": [
        {
            "name": "Recherche"
        }
    ]
}
