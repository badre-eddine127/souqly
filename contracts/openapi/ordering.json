{
    "openapi": "3.1.1",
    "info": {
        "title": "Souqly Ordering API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/vendor/orders": {
            "get": {
                "tags": [
                    "Espace vendeur"
                ],
                "summary": "Commandes contenant mes produits (seulement mes lignes)",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseOfVendorOrderResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/orders": {
            "post": {
                "tags": [
                    "Commandes"
                ],
                "summary": "Passer une commande (en-t\u00eate Idempotency-Key obligatoire) : 202 + Location",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PlaceOrderRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "tags": [
                    "Commandes"
                ],
                "summary": "Mes commandes, les plus r\u00e9centes d'abord",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderPage"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "tags": [
                    "Commandes"
                ],
                "summary": "Suivre une de mes commandes (US-07)",
                "operationId": "GetOrder",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/orders/{id}/cancellation": {
            "post": {
                "tags": [
                    "Commandes"
                ],
                "summary": "Annuler une commande non exp\u00e9di\u00e9e (US-08)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/vendor/orders/{id}/shipment": {
            "post": {
                "tags": [
                    "Espace vendeur"
                ],
                "summary": "Exp\u00e9dier mon colis : transporteur + num\u00e9ro de suivi (US-13)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ShipRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VendorOrderResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/vendor/orders/{id}/delivery": {
            "post": {
                "tags": [
                    "Espace vendeur"
                ],
                "summary": "Confirmer la livraison de mon colis",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VendorOrderResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "MoneyDto": {
                "required": [
                    "amount",
                    "currency"
                ],
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    }
                }
            },
            "OrderLineRequest": {
                "required": [
                    "productId",
                    "quantity"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "quantity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "OrderLineResponse": {
                "required": [
                    "productId",
                    "vendorId",
                    "productName",
                    "unitPrice",
                    "quantity",
                    "lineTotal"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "vendorId": {
                        "type": "string"
                    },
                    "productName": {
                        "type": "string"
                    },
                    "unitPrice": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "quantity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "lineTotal": {
                        "$ref": "#/components/schemas/MoneyDto"
                    }
                }
            },
            "OrderPage": {
                "required": [
                    "content",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages"
                ],
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderResponse"
                        }
                    },
                    "page": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "size": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "totalElements": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "totalPages": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                }
            },
            "OrderResponse": {
                "required": [
                    "id",
                    "customerId",
                    "status",
                    "statusReason",
                    "lines",
                    "total",
                    "createdAt",
                    "updatedAt",
                    "shipments"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "customerId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "statusReason": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderLineResponse"
                        }
                    },
                    "total": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "shipments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ShipmentResponse"
                        }
                    }
                }
            },
            "PageResponseOfVendorOrderResponse": {
                "required": [
                    "content",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages"
                ],
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/VendorOrderResponse"
                        }
                    },
                    "page": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "size": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "totalElements": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "totalPages": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    }
                },
                "description": "R\u00e9ponse pagin\u00e9e normalis\u00e9e : { content, page, size, totalElements, totalPages }."
            },
            "PlaceOrderRequest": {
                "required": [
                    "lines"
                ],
                "type": "object",
                "properties": {
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderLineRequest"
                        }
                    }
                }
            },
            "ShipRequest": {
                "required": [
                    "carrier",
                    "trackingNumber"
                ],
                "type": "object",
                "properties": {
                    "carrier": {
                        "type": "string"
                    },
                    "trackingNumber": {
                        "type": "string"
                    }
                }
            },
            "ShipmentResponse": {
                "required": [
                    "vendorId",
                    "carrier",
                    "trackingNumber",
                    "status",
                    "shippedAt",
                    "deliveredAt"
                ],
                "type": "object",
                "properties": {
                    "vendorId": {
                        "type": "string"
                    },
                    "carrier": {
                        "type": "string"
                    },
                    "trackingNumber": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "shippedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "deliveredAt": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "format": "date-time"
                    }
                }
            },
            "VendorOrderResponse": {
                "required": [
                    "orderId",
                    "status",
                    "lines",
                    "vendorTotal",
                    "createdAt",
                    "shipment"
                ],
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "status": {
                        "type": "string"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderLineResponse"
                        }
                    },
                    "vendorTotal": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "shipment": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "$ref": "#/components/schemas/ShipmentResponse"
                            }
                        ]
                    }
                }
            }
        },
        "securitySchemes": {
            "oauth2": {
                "type": "oauth2",
                "description": "Connexion Keycloak (realm souqly), client public souqly-web avec PKCE.",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/auth",
                        "tokenUrl": "http://localhost:8180/realms/souqly/protocol/openid-connect/token",
                        "scopes": {
                            "openid": "Identit\u00e9 OpenID Connect"
                        }
                    }
                }
            },
            "bearer": {
                "type": "http",
                "description": "Jeton d'acc\u00e8s Keycloak coll\u00e9 \u00e0 la main (Authorization: Bearer \u2026).",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "oauth2": [
                "openid"
            ]
        },
        {
            "bearer": []
        }
    ],
    "tags": [
        {
            "name": "Espace vendeur"
        },
        {
            "name": "Commandes"
        }
    ]
}
