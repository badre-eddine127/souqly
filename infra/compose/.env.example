# Copier en .env (ignoré par Git) et changer les valeurs. Aucun secret réel dans le dépôt.
POSTGRES_PASSWORD=change-me-postgres
CATALOG_DB_PASSWORD=change-me-catalog
INVENTORY_DB_PASSWORD=change-me-inventory
ORDERING_DB_PASSWORD=change-me-ordering
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification

# Keycloak : mot de passe de la console d'administration et secret du compte technique d'Ordering.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
ORDERING_CLIENT_SECRET=change-me-ordering-secret-32-chars-min
CATALOG_CLIENT_SECRET=change-me-catalog-secret-32-chars-min

# Images publiées (CI) : ghcr.io/<GHCR_OWNER>/souqly-<service>:<SOUQLY_VERSION>
GHCR_OWNER=souqly
SOUQLY_VERSION=dev
