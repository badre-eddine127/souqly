    {
      "id": 10,
      "type": "timeseries",
      "title": "Erreurs 5xx par service",
      "description": "Réponses 5xx par minute (503 = dépendance indisponible)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
